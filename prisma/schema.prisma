generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. MEME PAGE ADMIN / AFFILIATE TRACKING
// ==========================================

model Affiliate {
  id              String       @id @default(cuid())
  refCode         String       @unique // e.g., "SIGMA_MEMES"
  adminName       String       // e.g., "Rahul / @sigma_edits_7"
  upiId           String       // Payout address
  totalSalesCount Int          @default(0)
  unpaidBalance   Float        @default(0.0)
  totalPaid       Float        @default(0.0)
  createdAt       DateTime     @default(now())

  conversions     Conversion[]
  coupons         Coupon[]
}

model Conversion {
  id                String     @id @default(cuid())
  affiliateId       String?
  affiliate         Affiliate? @relation(fields: [affiliateId], references: [id])
  razorpayOrderId   String     @unique
  razorpayPaymentId String?    @unique
  saleAmount        Float      
  commissionEarned  Float      
  status            String     @default("SUCCESS")
  createdAt         DateTime   @default(now())
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique // e.g., "SIGMA25", "INSTA50"
  discountPct  Float      // e.g., 25.0 for 25% off
  isUnlimited  Boolean    @default(true)
  maxUses      Int?
  currentUses  Int        @default(0)
  isActive     Boolean    @default(true)

  // Optional link to an affiliate (if an influencer owns this code)
  affiliateId  String?
  affiliate    Affiliate? @relation(fields: [affiliateId], references: [id])

  createdAt    DateTime   @default(now())
}

// ==========================================
// 2. THE NEW SOFTMAXXING ENGINE (ACTIVE)
// ==========================================

model ScanReport {
  id               String   @id @default(cuid())
  isPaid           Boolean  @default(false)
  paymentId        String?  // Populated once Razorpay succeeds
  
  // Free Preview Data (The Bait)
  overallScore     Float
  geneticPotential Float?   // The hopium gap
  percentile       Int?     // The social hierarchy trigger
  symmetryScore    Float
  facialThirds     String
  
  // Locked Premium Data (The Cure - Stored securely as JSON)
  premiumData      Json

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ==========================================
// 3. LEGACY REPORT STORAGE (BACKUP)
// ==========================================

model UserReport {
  id           String   @id @default(cuid())
  deviceId     String   
  overallScore Float
  tierLabel    String   
  scoresJson   Json     
  paid         Boolean  @default(false)
  createdAt    DateTime @default(now())
}